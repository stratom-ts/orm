{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript"],
  "jsPlugins": ["./tools/oxlint-whitespace-plugin.mjs"],
  "categories": {
    "correctness": "error",
    "nursery": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "es2024": true,
    "node": true
  },
  "ignorePatterns": ["**/.output", "**/dist", "**/node_modules"],
  "extends": ["./config/oxlint/import.json"],
  "rules": {
    "stratom/whitespace": "error",
    "complexity": ["error", 20],
    "max-depth": ["error", 2]
  }
}
