{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "jsdoc"],
  "jsPlugins": ["./tools/index.ts"],
  "categories": {
    "correctness": "error",
    "nursery": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "es2024": true,
    "node": true
  },
  "ignorePatterns": ["**/.output", "**/dist", "**/node_modules"],
  "extends": [
    "./config/oxlint/import.json",
    "./config/oxlint/typescript.json",
    "./config/oxlint/vitest.json"
  ],
  "rules": {
    "stratom/whitespace": "error",
    "array-callback-return": "error",
    "complexity": ["error", 20],
    "curly": ["error", "multi-or-nest"],
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "max-depth": ["error", 2],
    "max-lines-per-function": ["error", { "max": 50, "skipBlankLines": true }],
    "no-else-return": "error",
    "no-lonely-if": "error",
    "no-var": "error",
    "prefer-const": "error",
    "jsdoc/require-param-description": "error",
    "jsdoc/require-returns-description": "error"
  }
}
