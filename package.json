{
  "name": "schema-orm",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/schema-orm.umd.cjs",
  "module": "./dist/schema-orm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/schema-orm.js"
    },
    "./helpers": {
      "types": "./src/helpers/index.ts",
      "import": "./src/helpers/index.ts"
    },
    "./schemas": {
      "types": "./src/schemas/index.ts",
      "import": "./src/schemas/index.ts"
    },
    "./types": {
      "types": "./src/types/constraints.ts",
      "import": "./src/types/constraints.ts"
    },
    "./utils": {
      "types": "./src/utils/isNumber.ts",
      "import": "./src/utils/isNumber.ts"
    }
  },
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "test": "vitest",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --type-aware --fix"
  },
  "dependencies": {
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "kysely": "^0.28.0",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.54.0",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "kysely": "^0.28.0"
  },
  "packageManager": "pnpm@10.26.1"
}
