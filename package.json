{
  "name": "schema-orm",
  "version": "0.1.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/schema-orm.umd.cjs",
  "module": "./dist/schema-orm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/schema-orm.js"
    }
  },
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "test": "vitest",
    "typecheck": "tsc",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "valibot": "^1.4.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "husky": "^9.1.7",
    "kysely": "^0.29.2",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "kysely": "^0.29.2"
  },
  "packageManager": "pnpm@11.9.0"
}
