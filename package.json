{
  "name": "@stratom/orm",
  "version": "0.0.1-pre-alpha.1",
  "description": "A schema-first ORM with Valibot schemas, desired-state migrations, and typed PostgreSQL and SQLite queries.",
  "homepage": "https://github.com/stratom-ts/orm#readme",
  "bugs": "https://github.com/stratom-ts/orm/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stratom-ts/orm.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/stratom.js"
    },
    "./naming": {
      "types": "./dist/naming.d.ts",
      "default": "./dist/naming.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "pre-alpha"
  },
  "scripts": {
    "build": "vite build",
    "prepack": "pnpm build",
    "dev": "vite",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:postgres": "vitest run --config vitest.integration.config.ts tests/integration/postgres",
    "test:integration:sqlite": "vitest run --config vitest.integration.config.ts tests/integration/sqlite",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "typecheck": "tsc",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "db0": "^0.4.2",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.60.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "^18.0.10",
    "husky": "^9.1.7",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.5"
  },
  "packageManager": "pnpm@11.15.1"
}
