{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [],
  "singleQuote": true,
  "semi": false,
  "trailingComma": "all",
  "printWidth": 80,
  "sortImports": {
    "groups": [
      ["type-import", "value-builtin", "value-external"],
      ["type-internal", "value-internal"],
      ["type-parent", "value-parent"],
      ["type-index", "value-index"],
      ["type-sibling", "value-sibling"],
      "unknown"
    ]
  }
}
